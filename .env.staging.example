# ============================
# Transit Platform — STAGING Environment Configuration
# ============================
# Copy this file to .env on the staging server and fill in actual values.
# NEVER commit the real .env to version control.

# Application
APP_ENV=staging
DOMAIN_NAME=api.yourdomain.com

# Database (PostgreSQL with PostGIS)
# Generate a strong random password for staging
POSTGRES_USER=transit_staging
POSTGRES_PASSWORD=<CHANGE_ME_SECURE_STAGING_DB_PASSWORD>
POSTGRES_DB=transit_staging_db

# Security
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<CHANGE_ME_SECURE_STAGING_JWT_SECRET>

# CORS (Restrict to frontend domain, or leave blank if only mobile app connects)
CORS_ORIGINS=https://yourdomain.com
