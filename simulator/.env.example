# GoBus Simulator Environment Configuration

# Base URL of the GoBus Backend API (no trailing slash)
GOBUS_BACKEND_URL=http://localhost:8000

# Primary Operator Credentials for Duty Simulation
GOBUS_OPERATOR_EMPLOYEE_CODE=O-001
GOBUS_OPERATOR_PASSWORD=Password123!

# Request Timeout in seconds
GOBUS_REQUEST_TIMEOUT=10.0

# Logging Level: DEBUG, INFO, WARNING, ERROR
GOBUS_LOG_LEVEL=INFO

# Future Multi-Operator definitions (Optional JSON string or path)
# GOBUS_OPERATORS_CONFIG=operators.json
