<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default, require HTTPS (cleartextTrafficPermitted="false") -->
    <base-config cleartextTrafficPermitted="false" />
    
    <!-- Allow cleartext ONLY for known local development IP ranges and Android emulator -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.1.100</domain> <!-- Example Demo PC IP -->
        <!-- Add your specific demo LAN IP here if different -->
    </domain-config>
</network-security-config>
