# ============================
# Transit Platform — Environment Configuration
# ============================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# Application
APP_ENV=development

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://transit:transit_dev_password@localhost:5432/transit_platform
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit_dev_password
POSTGRES_DB=transit_platform

# Security (placeholder — not used in BUILD 0)
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
