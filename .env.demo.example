# ──────────────────────────────────────────────────────────────
# GoBus Transit Platform — Demo Environment Configuration
# ──────────────────────────────────────────────────────────────

# Application Environment
APP_ENV=demo
# E.g. "production", "demo", "staging", "development"

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=transit_platform
# DATABASE_URL is constructed in docker-compose, but if running locally without compose:
# DATABASE_URL=postgresql://postgres:your_secure_db_password@localhost:5432/transit_platform

# Security (JWT)
# MUST BE A STRONG, RANDOM STRING IN DEMO/PRODUCTION
JWT_SECRET=replace_with_a_long_secure_random_string_for_demo
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
# For Demo PC hosting Admin Web, allow the domain/IP Admin Web is served on
# e.g., "http://192.168.1.100,https://gobus-demo.com"
CORS_ORIGINS=http://192.168.1.100
